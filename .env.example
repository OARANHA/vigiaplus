# ---- Fundação VigiaPlus (H0) ---------------------------------------------
# Nenhum destes valores é necessário para rodar os testes.
PORT=3000
NODE_ENV=development

# Segredo de sessão. Em produção: gerar com `openssl rand -hex 32`.
# NUNCA reutilizar como chave de criptografia de credenciais (ADR-09).
SESSION_SECRET=troque-este-valor

# Chave INDEPENDENTE e versionada para credenciais de conectores (ADR-09).
CREDENTIALS_ENC_KEY_V1=troque-este-valor-tambem

# Webhooks de pagamento (Stripe / Pix).
VIGIA_WEBHOOK_SECRET=troque-este-valor
STRIPE_API_KEY=
ASAAS_API_KEY=

# Chaves de provedores LLM — referenciadas por ENV: no banco, nunca gravadas nele.
OPENAI_API_KEY=
AZURE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Escape hatch SOMENTE para desenvolvimento local com Ollama / LM Studio.
# Deixe DESLIGADO em produção (é o que o teste adversarial A7 protege).
VIGIA_ALLOW_INSECURE_LLM=0
VIGIA_ALLOW_PRIVATE_LLM=0

# Banco (H0 usa store em memória; H1 introduz migrações versionadas + RLS).
DATABASE_URL=postgres://vigiaplus:senha@postgres:5432/vigiaplus
REDIS_URL=redis://redis:6379
